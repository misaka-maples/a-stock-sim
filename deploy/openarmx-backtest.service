[Unit]
Description=Offline cache-only backtest scheduler
After=openarmx-quant.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=openarmx
Group=openarmx
WorkingDirectory=/home/openarmx/test
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/openarmx/test/backtest_worker.py
Restart=on-failure
RestartSec=30
Slice=openarmx-quant.slice
Nice=19
CPUWeight=1
CPUQuota=50%
IOSchedulingClass=idle
IOWeight=1
MemoryHigh=448M
MemoryMax=600M
MemorySwapMax=0
OOMPolicy=stop
KillMode=control-group
TimeoutStopSec=5
UMask=0077
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/openarmx/test/data/backtest_jobs
PrivateTmp=true
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
LogNamespace=openarmx-quant
SyslogIdentifier=openarmx-backtest

[Install]
WantedBy=multi-user.target
